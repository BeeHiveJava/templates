{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "suppressNotifications": ["prIgnoreNotification"],
  "extends": [
    "config:base",
    "security:minimumReleaseAgeNpm",
    ":enablePreCommit",
    ":disableDependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm packages in pre-commit additional_dependencies",
      "managerFilePatterns": ["/(^|/)\\.pre-commit-config\\.ya?ml$/"],
      "matchStrings": [
        "[\"'](?<depName>@?[^@\"'\\s]+)@(?<currentValue>[^\"'\\s]+)[\"']"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "groupName": "{{datasource}} dependencies",
      "groupSlug": "{{datasource}}",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "vite-plus",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"]
    },
    {
      "groupName": "biome",
      "matchPackageNames": ["@biomejs/biome", "biomejs/pre-commit"]
    }
  ]
}
