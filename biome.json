{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "vcs": {
    "enabled": true,
    "useIgnoreFile": true,
    "clientKind": "git"
  },
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "style": {
        "useReadonlyClassProperties": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        }
      }
    }
  }
}
