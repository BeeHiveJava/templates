{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "templates",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["EditorConfig.EditorConfig", "redhat.vscode-yaml", "VoidZero.vite-plus-extension-pack"],
      "settings": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "oxc.disableNestedConfig": true,
        "oxc.fmt.disableNestedConfig": true
      }
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "npx --yes --package=vite-plus vp install"
}
